'use client'

import * as THREE from 'three'
import { Html } from '@react-three/drei'

interface OfficeDecorProps {
  deskPositions: [number, number, number][]
  agents: Array<{ status: string; color: string }>
}

export default function OfficeDecor({ deskPositions, agents }: OfficeDecorProps) {
  return (
    <group>
      {/* ==================== DINDING & DEKORASI DINDING ==================== */}
      
      {/* Whiteboard on back wall */}
      <group position={[0, 2, -9.5]}>
        <mesh>
          <boxGeometry args={[4, 2.5, 0.1]} />
          <meshStandardMaterial color="#1a1a1a" />
        </mesh>
        <mesh position={[0, 0, 0.06]}>
          <planeGeometry args={[3.8, 2.3]} />
          <meshStandardMaterial color="#f5f5f5" roughness={0.2} />
        </mesh>
        <Html position={[0, 0, 0.1]} transform occlude>
          <div
            style={{
              width: '380px',
              height: '230px',
              padding: '20px',
              fontSize: '14px',
              fontFamily: 'monospace',
              color: '#2563eb',
              lineHeight: '1.6',
              pointerEvents: 'none',
            }}
          >
            <div>✓ Sprint Goals</div>
            <div>✓ API Design Review</div>
            <div>✓ DB Schema Migration</div>
            <div style={{ marginTop: '10px', color: '#dc2626' }}>
              ⚠ Blockers: CI/CD
            </div>
          </div>
        </Html>
      </group>

      {/* Wall Art - Left Wall (3 pieces) */}
      <group position={[-14.5, 2, -5]} rotation={[0, Math.PI / 2, 0]}>
        <mesh>
          <boxGeometry args={[2, 2, 0.05]} />
          <meshStandardMaterial color="#0f172a" />
        </mesh>
        <mesh position={[0, 0, 0.03]}>
          <planeGeometry args={[1.8, 1.8]} />
          <meshStandardMaterial color="#6366f1" roughness={0.3} />
        </mesh>
        <mesh position={[-0.3, 0.3, 0.04]}>
          <circleGeometry args={[0.4, 6]} />
          <meshStandardMaterial color="#8b5cf6" />
        </mesh>
        <mesh position={[0.3, -0.2, 0.04]}>
          <circleGeometry args={[0.3, 3]} />
          <meshStandardMaterial color="#ec4899" />
        </mesh>
      </group>

      <group position={[-14.5, 2, 2]} rotation={[0, Math.PI / 2, 0]}>
        <mesh>
          <boxGeometry args={[1.5, 1.5, 0.05]} />
          <meshStandardMaterial color="#0f172a" />
        </mesh>
        <mesh position={[0, 0, 0.03]}>
          <planeGeometry args={[1.3, 1.3]} />
          <meshStandardMaterial color="#f59e0b" roughness={0.3} />
        </mesh>
      </group>

      {/* Wall Art - Right Wall (2 pieces) */}
      <group position={[14.5, 2, 0]} rotation={[0, -Math.PI / 2, 0]}>
        <mesh>
          <boxGeometry args={[2.5, 1.5, 0.05]} />
          <meshStandardMaterial color="#0f172a" />
        </mesh>
        <mesh position={[0, 0, 0.03]}>
          <planeGeometry args={[2.3, 1.3]} />
          <meshStandardMaterial color="#10b981" roughness={0.3} />
        </mesh>
      </group>

      <group position={[14.5, 2.5, -6]} rotation={[0, -Math.PI / 2, 0]}>
        <mesh>
          <boxGeometry args={[1.8, 1.2, 0.05]} />
          <meshStandardMaterial color="#0f172a" />
        </mesh>
        <mesh position={[0, 0, 0.03]}>
          <planeGeometry args={[1.6, 1.0]} />
          <meshStandardMaterial color="#3b82f6" roughness={0.3} />
        </mesh>
      </group>

      {/* Clock on back wall */}
      <group position={[5, 2.8, -9.8]}>
        <mesh>
          <cylinderGeometry args={[0.4, 0.4, 0.08, 32]} />
          <meshStandardMaterial color="#1f2937" metalness={0.5} />
        </mesh>
        <mesh position={[0, 0, 0.05]}>
          <circleGeometry args={[0.35, 32]} />
          <meshStandardMaterial color="#f3f4f6" />
        </mesh>
        {/* Clock hands */}
        <mesh position={[0, 0.1, 0.06]} rotation={[0, 0, Math.PI / 4]}>
          <boxGeometry args={[0.02, 0.2, 0.01]} />
          <meshStandardMaterial color="#1f2937" />
        </mesh>
        <mesh position={[0, 0.08, 0.06]} rotation={[0, 0, -Math.PI / 3]}>
          <boxGeometry args={[0.02, 0.15, 0.01]} />
          <meshStandardMaterial color="#1f2937" />
        </mesh>
      </group>

      {/* ==================== TANAMAN (8 locations) ==================== */}
      
      {/* Large floor plants - corners */}
      <group position={[-7, 0, 7]}>
        <mesh position={[0, 0.4, 0]}>
          <cylinderGeometry args={[0.35, 0.4, 0.8, 8]} />
          <meshStandardMaterial color="#8b4513" roughness={0.9} />
        </mesh>
        {[0, 1, 2, 3, 4].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 5) * 0.35,
              1.0 + Math.random() * 0.5,
              Math.sin((i * Math.PI * 2) / 5) * 0.35,
            ]}
            rotation={[Math.random() * 0.5, Math.random() * Math.PI * 2, 0]}
          >
            <coneGeometry args={[0.18, 0.6, 4]} />
            <meshStandardMaterial color="#16a34a" />
          </mesh>
        ))}
      </group>

      <group position={[7, 0, 7]}>
        <mesh position={[0, 0.4, 0]}>
          <cylinderGeometry args={[0.35, 0.4, 0.8, 8]} />
          <meshStandardMaterial color="#92400e" roughness={0.9} />
        </mesh>
        {[0, 1, 2, 3, 4].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 4 + i * 0.3) * 0.3,
              0.9 + i * 0.2,
              Math.sin((i * Math.PI * 2) / 4 + i * 0.3) * 0.3,
            ]}
          >
            <sphereGeometry args={[0.22, 8, 8]} />
            <meshStandardMaterial color="#22c55e" />
          </mesh>
        ))}
      </group>

      {/* Medium plants - along walls */}
      {/* Left wall plants */}
      <group position={[-13, 0, -3]}>
        <mesh position={[0, 0.25, 0]}>
          <cylinderGeometry args={[0.25, 0.28, 0.5, 8]} />
          <meshStandardMaterial color="#78350f" roughness={0.9} />
        </mesh>
        {[0, 1, 2].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 3) * 0.2,
              0.6 + i * 0.15,
              Math.sin((i * Math.PI * 2) / 3) * 0.2,
            ]}
          >
            <coneGeometry args={[0.12, 0.4, 4]} />
            <meshStandardMaterial color="#15803d" />
          </mesh>
        ))}
      </group>

      <group position={[-13, 0, 4]}>
        <mesh position={[0, 0.25, 0]}>
          <cylinderGeometry args={[0.25, 0.28, 0.5, 8]} />
          <meshStandardMaterial color="#a16207" roughness={0.9} />
        </mesh>
        {[0, 1, 2, 3].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 4) * 0.18,
              0.55 + Math.sin(i) * 0.1,
              Math.sin((i * Math.PI * 2) / 4) * 0.18,
            ]}
          >
            <sphereGeometry args={[0.15, 8, 8]} />
            <meshStandardMaterial color="#16a34a" />
          </mesh>
        ))}
      </group>

      {/* Right wall plants */}
      <group position={[13, 0, -5]}>
        <mesh position={[0, 0.3, 0]}>
          <cylinderGeometry args={[0.28, 0.32, 0.6, 8]} />
          <meshStandardMaterial color="#854d0e" roughness={0.9} />
        </mesh>
        {[0, 1, 2].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 3) * 0.22,
              0.7 + i * 0.18,
              Math.sin((i * Math.PI * 2) / 3) * 0.22,
            ]}
          >
            <coneGeometry args={[0.14, 0.45, 4]} />
            <meshStandardMaterial color="#166534" />
          </mesh>
        ))}
      </group>

      <group position={[13, 0, 3]}>
        <mesh position={[0, 0.25, 0]}>
          <cylinderGeometry args={[0.25, 0.28, 0.5, 8]} />
          <meshStandardMaterial color="#92400e" roughness={0.9} />
        </mesh>
        {[0, 1, 2, 3].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 4) * 0.2,
              0.6 + i * 0.12,
              Math.sin((i * Math.PI * 2) / 4) * 0.2,
            ]}
          >
            <sphereGeometry args={[0.13, 8, 8]} />
            <meshStandardMaterial color="#15803d" />
          </mesh>
        ))}
      </group>

      {/* ==================== OFFICE FURNITURE ==================== */}

      {/* Printer Station - back left corner */}
      <group position={[-10, 0, -8]}>
        {/* Printer table */}
        <mesh position={[0, 0.4, 0]}>
          <boxGeometry args={[1.2, 0.8, 0.7]} />
          <meshStandardMaterial color="#374151" />
        </mesh>
        {/* Printer body */}
        <mesh position={[0, 1.0, 0]}>
          <boxGeometry args={[0.8, 0.4, 0.6]} />
          <meshStandardMaterial color="#1f2937" />
        </mesh>
        {/* Printer top (scanner) */}
        <mesh position={[0, 1.25, 0.05]} rotation={[-0.1, 0, 0]}>
          <boxGeometry args={[0.8, 0.08, 0.5]} />
          <meshStandardMaterial color="#111827" />
        </mesh>
        {/* Paper tray */}
        <mesh position={[0, 0.9, 0.35]}>
          <boxGeometry args={[0.6, 0.05, 0.2]} />
          <meshStandardMaterial color="#f3f4f6" />
        </mesh>
        {/* Stack of paper on table */}
        <mesh position={[0.4, 0.85, 0.1]}>
          <boxGeometry args={[0.25, 0.1, 0.3]} />
          <meshStandardMaterial color="#ffffff" />
        </mesh>
        {/* Status LED */}
        <mesh position={[0.3, 1.0, 0.31]}>
          <sphereGeometry args={[0.02, 8, 8]} />
          <meshStandardMaterial color="#10b981" emissive="#10b981" emissiveIntensity={0.8} />
        </mesh>
      </group>

      {/* Filing Cabinet - back right corner */}
      <group position={[10, 0, -8]}>
        {/* Cabinet body */}
        <mesh position={[0, 0.6, 0]}>
          <boxGeometry args={[0.5, 1.2, 0.6]} />
          <meshStandardMaterial color="#6b7280" metalness={0.6} roughness={0.4} />
        </mesh>
        {/* Drawers (3 layers) */}
        {[0, 1, 2].map((i) => (
          <group key={i} position={[0, 0.2 + i * 0.35, 0]}>
            <mesh position={[0, 0, 0.31]}>
              <boxGeometry args={[0.45, 0.3, 0.02]} />
              <meshStandardMaterial color="#4b5563" metalness={0.7} />
            </mesh>
            {/* Handle */}
            <mesh position={[0, 0, 0.33]}>
              <boxGeometry args={[0.15, 0.03, 0.02]} />
              <meshStandardMaterial color="#1f2937" metalness={0.9} />
            </mesh>
          </group>
        ))}
      </group>

      {/* Bookshelf - left wall */}
      <group position={[-13.5, 0, -7]}>
        {/* Frame */}
        <mesh position={[0, 1.2, 0]}>
          <boxGeometry args={[0.4, 2.4, 1.5]} />
          <meshStandardMaterial color="#44403c" />
        </mesh>
        {/* Shelves (4 levels) */}
        {[0, 1, 2, 3].map((i) => (
          <mesh key={i} position={[0, 0.2 + i * 0.6, 0]}>
            <boxGeometry args={[0.35, 0.05, 1.45]} />
            <meshStandardMaterial color="#78716c" />
          </mesh>
        ))}
        {/* Books (random placement) */}
        {Array.from({ length: 12 }).map((_, i) => {
          const shelf = Math.floor(i / 3)
          const pos = (i % 3) - 1
          const colors = ['#ef4444', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899']
          return (
            <mesh
              key={i}
              position={[0.15, 0.25 + shelf * 0.6, pos * 0.4]}
              rotation={[0, Math.random() * 0.2 - 0.1, 0]}
            >
              <boxGeometry args={[0.08, 0.35, 0.25]} />
              <meshStandardMaterial color={colors[i % colors.length]} />
            </mesh>
          )
        })}
      </group>

      {/* Water Cooler - back right (moved slightly) */}
      <group position={[8.5, 0, -8.5]}>
        <mesh position={[0, 0.25, 0]}>
          <boxGeometry args={[0.4, 0.5, 0.4]} />
          <meshStandardMaterial color="#e5e7eb" />
        </mesh>
        <mesh position={[0, 0.8, 0]}>
          <cylinderGeometry args={[0.25, 0.25, 0.6, 16]} />
          <meshStandardMaterial color="#38bdf8" transparent opacity={0.7} />
        </mesh>
        <mesh position={[0, 1.15, 0]}>
          <cylinderGeometry args={[0.15, 0.25, 0.1, 16]} />
          <meshStandardMaterial color="#0369a1" />
        </mesh>
        {/* Cups */}
        <mesh position={[0.25, 0.28, 0.25]}>
          <cylinderGeometry args={[0.05, 0.06, 0.08, 12]} />
          <meshStandardMaterial color="#ffffff" />
        </mesh>
      </group>

      {/* Trash bins (2 locations) */}
      <group position={[-8.5, 0, -8]}>
        <mesh position={[0, 0.25, 0]}>
          <cylinderGeometry args={[0.2, 0.25, 0.5, 16]} />
          <meshStandardMaterial color="#1f2937" />
        </mesh>
      </group>

      <group position={[5, 0, 6.5]}>
        <mesh position={[0, 0.25, 0]}>
          <cylinderGeometry args={[0.2, 0.25, 0.5, 16]} />
          <meshStandardMaterial color="#1f2937" />
        </mesh>
      </group>

      {/* ==================== DESK DECORATIONS (per desk) ==================== */}
      
      {deskPositions.map((pos, idx) => {
        const agent = agents[idx]
        return (
          <group key={idx} position={pos as [number, number, number]}>
            {/* Coffee Mug - right side */}
            <group position={[0.6, 0.8, -0.1]}>
              <mesh>
                <cylinderGeometry args={[0.08, 0.1, 0.15, 16]} />
                <meshStandardMaterial color="#1e293b" roughness={0.4} />
              </mesh>
              <mesh position={[0.1, 0, 0]} rotation={[0, 0, Math.PI / 2]}>
                <torusGeometry args={[0.06, 0.02, 8, 16, Math.PI]} />
                <meshStandardMaterial color="#1e293b" />
              </mesh>
            </group>

            {/* Desk Lamp - left side with STATUS-BASED LIGHTING */}
            <group position={[-0.5, 0.8, -0.3]}>
              <mesh>
                <cylinderGeometry args={[0.1, 0.12, 0.05, 16]} />
                <meshStandardMaterial color="#374151" metalness={0.8} />
              </mesh>
              <mesh position={[0, 0.3, 0]} rotation={[0, 0, Math.PI / 6]}>
                <cylinderGeometry args={[0.02, 0.02, 0.6, 8]} />
                <meshStandardMaterial color="#4b5563" metalness={0.6} />
              </mesh>
              <mesh position={[0.2, 0.6, 0]} rotation={[0, 0, Math.PI / 3]}>
                <coneGeometry args={[0.15, 0.2, 16]} />
                <meshStandardMaterial
                  color={agent.status === 'working' ? agent.color : '#6b7280'}
                  emissive={agent.status === 'working' ? agent.color : '#000000'}
                  emissiveIntensity={agent.status === 'working' ? 0.5 : 0.1}
                />
              </mesh>

              {agent.status === 'working' && (
                <pointLight
                  position={[0.2, 0.7, 0]}
                  intensity={0.8}
                  distance={3}
                  color={agent.color}
                  castShadow
                />
              )}
            </group>

            {/* Desk plant - back corner */}
            <group position={[0.4, 0.8, -0.5]}>
              <mesh>
                <cylinderGeometry args={[0.06, 0.07, 0.12, 8]} />
                <meshStandardMaterial color="#d97706" roughness={0.8} />
              </mesh>
              {[0, 1, 2].map((i) => (
                <mesh
                  key={i}
                  position={[
                    Math.cos((i * Math.PI * 2) / 3) * 0.08,
                    0.15,
                    Math.sin((i * Math.PI * 2) / 3) * 0.08,
                  ]}
                >
                  <sphereGeometry args={[0.05, 8, 8]} />
                  <meshStandardMaterial color="#15803d" />
                </mesh>
              ))}
            </group>

            {/* Notepad */}
            <mesh position={[-0.3, 0.81, 0.1]}>
              <boxGeometry args={[0.2, 0.01, 0.25]} />
              <meshStandardMaterial color="#fbbf24" />
            </mesh>

            {/* Pen holder with pens */}
            <group position={[0.5, 0.8, 0.15]}>
              <mesh>
                <cylinderGeometry args={[0.045, 0.05, 0.1, 12]} />
                <meshStandardMaterial color="#1f2937" />
              </mesh>
              {[0, 1, 2].map((i) => (
                <mesh
                  key={i}
                  position={[
                    Math.cos((i * Math.PI * 2) / 3) * 0.02,
                    0.12,
                    Math.sin((i * Math.PI * 2) / 3) * 0.02,
                  ]}
                >
                  <cylinderGeometry args={[0.008, 0.008, 0.15, 8]} />
                  <meshStandardMaterial color={i === 0 ? '#3b82f6' : i === 1 ? '#ef4444' : '#1f2937'} />
                </mesh>
              ))}
            </group>

            {/* Mouse pad */}
            <mesh position={[0.2, 0.805, 0.3]} rotation={[-Math.PI / 2, 0, 0]}>
              <planeGeometry args={[0.35, 0.28]} />
              <meshStandardMaterial color="#374151" />
            </mesh>
          </group>
        )
      })}

      {/* ==================== MEETING TABLE ==================== */}
      
      <group position={[0, 0, 0]}>
        <mesh position={[0, 0.7, 0]}>
          <boxGeometry args={[3, 0.08, 1.5]} />
          <meshStandardMaterial color="#3f2711" roughness={0.3} metalness={0.2} />
        </mesh>
        {[
          [-1.3, 0.35, -0.6],
          [1.3, 0.35, -0.6],
          [-1.3, 0.35, 0.6],
          [1.3, 0.35, 0.6],
        ].map((legPos, idx) => (
          <mesh key={idx} position={legPos as [number, number, number]}>
            <cylinderGeometry args={[0.06, 0.06, 0.7, 8]} />
            <meshStandardMaterial color="#1f1410" />
          </mesh>
        ))}
        
        {/* Laptop */}
        <group position={[0, 0.75, 0]} rotation={[-Math.PI / 8, 0, 0]}>
          <mesh position={[0, 0.02, 0.05]}>
            <boxGeometry args={[0.4, 0.02, 0.3]} />
            <meshStandardMaterial color="#1e293b" metalness={0.8} />
          </mesh>
          <mesh position={[0, 0.15, -0.1]} rotation={[Math.PI / 12, 0, 0]}>
            <boxGeometry args={[0.4, 0.28, 0.02]} />
            <meshStandardMaterial color="#0f172a" metalness={0.7} />
          </mesh>
          <mesh position={[0, 0.15, -0.09]}>
            <planeGeometry args={[0.35, 0.23]} />
            <meshStandardMaterial color="#1e40af" emissive="#1e40af" emissiveIntensity={0.3} />
          </mesh>
        </group>

        {/* Coffee cups on meeting table */}
        <group position={[-0.8, 0.75, 0.3]}>
          <mesh>
            <cylinderGeometry args={[0.06, 0.07, 0.12, 16]} />
            <meshStandardMaterial color="#ffffff" />
          </mesh>
        </group>

        <group position={[0.9, 0.75, -0.2]}>
          <mesh>
            <cylinderGeometry args={[0.06, 0.07, 0.12, 16]} />
            <meshStandardMaterial color="#1f2937" />
          </mesh>
        </group>

        {/* Documents/papers */}
        <mesh position={[-0.3, 0.76, -0.3]}>
          <boxGeometry args={[0.25, 0.005, 0.35]} />
          <meshStandardMaterial color="#f3f4f6" />
        </mesh>
      </group>

      {/* Small table plant - on meeting table */}
      <group position={[1.2, 0.75, 0.5]}>
        <mesh>
          <cylinderGeometry args={[0.08, 0.09, 0.15, 8]} />
          <meshStandardMaterial color="#92400e" roughness={0.9} />
        </mesh>
        {[0, 1, 2, 3].map((i) => (
          <mesh
            key={i}
            position={[
              Math.cos((i * Math.PI * 2) / 4) * 0.1,
              0.2,
              Math.sin((i * Math.PI * 2) / 4) * 0.1,
            ]}
          >
            <sphereGeometry args={[0.06, 8, 8]} />
            <meshStandardMaterial color="#16a34a" />
          </mesh>
        ))}
      </group>
    </group>
  )
}

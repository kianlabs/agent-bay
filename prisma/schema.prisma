generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Agent {
  id              String    @id @default(cuid())
  name            String
  color           String
  status          String    @default("idle")
  currentTask     String
  tasksCompleted  Int       @default(0)
  tasksInQueue    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Tier 1: Error handling
  lastError       String?
  errorDetails    String?
  errorTimestamp  DateTime?
  maxCapacity     Int       @default(20)
  
  // Relations
  events          Event[]
  activities      Activity[]
  errorLogs       ErrorLog[]
}

model Metrics {
  id                    String   @id @default(cuid())
  tasksCompletedToday   Int      @default(0)
  tasksInProgress       Int      @default(0)
  prsReviewed           Int      @default(0)
  buildStatus           String   @default("passing") // passing | failing
  lastBuildTime         String   @default("never")
  testsPassed           Int      @default(0)
  testsFailed           Int      @default(0)
  updatedAt             DateTime @updatedAt
}

model Event {
  id        String   @id @default(cuid())
  agentId   String
  message   String
  timestamp DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
}

// Tier 1: Activity Timeline
model Activity {
  id        String   @id @default(cuid())
  agentId   String
  agentName String
  action    String
  type      String   // 'task-completed' | 'error' | 'deployment' | 'pr-reviewed' | 'test-run'
  metadata  String?  // JSON string
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([timestamp])
  @@index([agentId])
}

// Tier 1: Error Logging
model ErrorLog {
  id         String    @id @default(cuid())
  agentId    String
  message    String
  details    String
  stack      String?
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
  @@index([createdAt])
}

// Task queue for real Hermes Agent execution
model Task {
  id          String    @id @default(cuid())
  prompt      String    // User's original request
  assignedTo  String?   // Agent name (Frontend/Backend/Research/Review)
  status      String    @default("pending") // pending | running | completed | error
  result      String?   // Output from Hermes agent
  error       String?   // Error message if failed
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  
  @@index([status])
  @@index([createdAt])
}
